rules_version = '2';
// Reglas de Firestore: pegar en Firebase → Firestore Database → Reglas.
// Cambia los dos correos por los de ustedes (en minúsculas). Solo esas dos cuentas pueden leer y escribir.
service cloud.firestore {
  match /databases/{database}/documents {
    function isCouple() {
      return request.auth != null
        && request.auth.token.email in ['TU_CORREO@ejemplo.com', 'CORREO_PAREJA@ejemplo.com'];
    }
    match /couples/{couple}/{document=**} {
      allow read, write: if isCouple();
    }
  }
}
