rules_version = '2';
// Reglas de Firestore: pegar en Firebase → Firestore Database → Reglas.
// Cambia los dos correos por los de ustedes (en minúsculas).
service cloud.firestore {
  match /databases/{database}/documents {
    function isCouple() {
      return request.auth != null
        && request.auth.token.email in ['TU_CORREO@ejemplo.com', 'CORREO_PAREJA@ejemplo.com'];
    }
    // Todo lo compartido: solo esas dos cuentas pueden leer y escribir.
    match /couples/{couple}/{document=**} {
      allow read, write: if isCouple();
    }
    // Lo privado de cada uno (ideas de regalo): solo su dueño.
    match /private/{owner}/{document=**} {
      allow read, write: if isCouple() && request.auth.uid == owner;
    }
  }
}
